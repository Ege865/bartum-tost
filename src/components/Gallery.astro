---
// Editorial photo wall: five frames of different sizes; columns travel at different speeds.
import { Picture } from 'astro:assets';
import tahta from '../assets/stock/tost-tahta.jpg';
import patates from '../assets/stock/tost-patates.jpg';
import cay from '../assets/stock/cay.jpg';
import spatula from '../assets/stock/spatula.jpg';
import usta from '../assets/photos/usta-tabak.jpg';

const tiles = [
  { src: patates, alt: 'Kaşarlı tost dilimleri, patates kızartması ve ketçap', cls: 't1', speed: 6 },
  { src: tahta, alt: 'Ahşap masada ızgara izli kaşarlı tost', cls: 't2', speed: -6 },
  { src: usta, alt: 'Sedat Candaş, tost dilimleri ve patatesle dolu paylaşım tabağını masaya uzatıyor', cls: 't3', speed: 5 },
  { src: cay, alt: 'Ahşap masada ince belli bardakta tavşan kanı çay', cls: 't4', speed: -10 },
  { src: spatula, alt: 'Geniş sacın başında spatulayla çalışan usta', cls: 't5', speed: 4 },
];
---
<section class="gallery ground-cream on-cream" id="masa" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery__head">
      <h2 id="gallery-title" class="display h2 gallery__title" data-split>Tost, patates, çay: masaya sıcak gelir.</h2>
      <p class="lead">Ortaya bir tabak, masaya herkes. Paylaşmak için dolduruyoruz.</p>
    </div>
    <div class="gallery__grid">
      {tiles.map((t) => (
        <div class={`frame gallery__tile ${t.cls}`} data-reveal-img data-speed={t.speed}>
          <Picture src={t.src} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 40vw, 92vw" alt={t.alt} data-parallax />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { padding-block: var(--s-10); overflow: hidden; }
  .gallery__head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--s-6); align-items: end; margin-bottom: var(--s-8); }
  .gallery__title { color: var(--blue); }
  .gallery__head .lead { justify-self: end; }

  .gallery__grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(4rem, 7vw, 7.5rem); gap: var(--s-5);
  }
  .gallery__tile :global(picture) { display: block; height: 100%; }
  .gallery__tile :global(img) { transition: scale 600ms var(--ease-out); }
  .gallery__tile:hover :global(img) { scale: 1.03; }
  .t1 { grid-column: 1 / span 4; grid-row: 1 / span 6; }
  .t2 { grid-column: 5 / span 5; grid-row: 2 / span 3; }
  .t3 { grid-column: 10 / span 3; grid-row: 1 / span 5; }
  .t4 { grid-column: 5 / span 3; grid-row: 5 / span 3; }
  .t5 { grid-column: 8 / span 5; grid-row: 6 / span 3; }

  @media (max-width: 899px) {
    .gallery { padding-block: var(--s-9); }
    .gallery__head { grid-template-columns: 1fr; margin-bottom: var(--s-6); }
    .gallery__head .lead { justify-self: start; }
    .gallery__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: 22vw; gap: var(--s-3); }
    .t1 { grid-column: 1 / span 3; grid-row: 1 / span 4; }
    .t2 { grid-column: 4 / span 3; grid-row: 1 / span 2; }
    .t3 { grid-column: 4 / span 3; grid-row: 3 / span 3; }
    .t4 { grid-column: 1 / span 3; grid-row: 5 / span 2; }
    .t5 { grid-column: 1 / span 6; grid-row: 7 / span 2; }
  }
</style>
