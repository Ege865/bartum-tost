---
import { nav, site } from '../data/site';
---
<header class="nav ground-blue at-top" data-nav>
  <div class="wrap nav__bar">
    <a class="nav__mark display" href="#top" aria-label="Bartum Tost, sayfa başı">Bartum<span>Tost</span></a>

    <nav class="nav__links" aria-label="Ana menü">
      {nav.map((n) => <a class="link" href={n.href}>{n.label}</a>)}
    </nav>

    <a class="btn nav__cta" href={site.phone.href}>Hemen ara</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="nav__toggle-label">Menü</span>
      <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="sheet ground-blue" id="menu" hidden data-menu>
    <nav class="wrap sheet__inner" aria-label="Mobil menü">
      {nav.map((n) => <a class="sheet__link display" href={n.href} data-menu-link>{n.label}</a>)}
      <div class="sheet__foot">
        <a class="btn" href={site.phone.href}>Hemen ara</a>
        <a class="link" href={site.instagram.href} rel="noopener">Instagram {site.instagram.handle}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const sheet = document.querySelector<HTMLElement>('[data-menu]')!;
  const label = toggle.querySelector('.nav__toggle-label')!;
  const set = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Kapat' : 'Menü';
    sheet.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) sheet.querySelector<HTMLElement>('a')?.focus();
  };
  toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sheet.hidden) { set(false); toggle.focus(); }
  });
  matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && set(false));
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 100;
    border-bottom: 1px solid var(--blue-deep);
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  /* Over the hero photograph the bar is clear; it fills with blue once the page moves. */
  .nav.at-top:not(:has([aria-expanded='true'])) { background-color: transparent; border-bottom-color: transparent; }
  .nav.is-hidden { transform: translateY(-100%); }
  .nav__bar {
    height: var(--nav-h);
    display: flex; align-items: center; gap: var(--s-6);
  }
  .nav__mark {
    font-size: 1.75rem; line-height: 1; text-decoration: none; color: var(--cream);
    margin-right: auto; display: inline-flex; align-items: center; min-height: 2.75rem;
  }
  .nav__mark span { color: var(--amber); margin-left: 0.22em; }
  .nav__links { display: flex; gap: var(--s-6); }
  .nav__links .link { color: var(--cream); }
  .nav__cta { min-height: 2.75rem; padding-inline: var(--s-5); }

  .nav__toggle {
    display: none; align-items: center; gap: var(--s-3);
    min-height: 2.75rem; padding: 0 var(--s-2);
    background: none; border: 0; cursor: pointer; color: var(--cream); font-weight: 700;
  }
  .nav__burger { display: grid; gap: 6px; width: 24px; }
  .nav__burger i { display: block; height: 2px; background: currentColor; transition: transform var(--dur) var(--ease-out); }
  .nav__toggle[aria-expanded='true'] .nav__burger i:first-child { transform: translateY(4px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] .nav__burger i:last-child { transform: translateY(-4px) rotate(-45deg); }

  .sheet { position: fixed; inset: var(--nav-h) 0 0; overflow-y: auto; }
  .sheet__inner { display: flex; flex-direction: column; gap: var(--s-2); padding-block: var(--s-7); min-height: 100%; }
  .sheet__link {
    font-size: clamp(3rem, 15vw, 5.5rem); color: var(--cream); text-decoration: none;
    padding-block: var(--s-2); border-bottom: 1px solid var(--blue-deep);
  }
  .sheet__link:hover { color: var(--amber); }
  .sheet__foot { margin-top: auto; display: flex; flex-direction: column; gap: var(--s-4); padding-top: var(--s-7); }
  .sheet__foot .btn { justify-content: center; }

  @media (max-width: 899px) {
    .nav__links, .nav__cta { display: none; }
    .nav__toggle { display: inline-flex; }
  }
</style>
