---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Fire from '../components/Fire.astro';
import Gallery from '../components/Gallery.astro';
import Branches from '../components/Branches.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
---
<Base title="Bartum Tost · Orhangazi'de sacda bastırılan tost, 2008'den beri">
  <Intro />
  <Nav />
  <main id="icerik">
    <Hero />
    <Story />
    <Fire />
    <Gallery />
    <Branches />
    <Visit />
  </main>
  <Footer />
  <ActionBar />
  <script>
    import { initMotion } from '../motion';
    initMotion();
  </script>
</Base>
